static void recording_storage_checks(void)
{
    app_view_t original = s_state;
    s_state.mode = INPUT_AUDIO;
    s_state.overlay = APP_OVERLAY_AUDIO;
    s_state.locked = s_state.screen_off = s_state.remote_owned = false;
    s_state.capture_indicator_required = s_state.audio_active = s_state.listening = false;
    ++s_state.ui_revision; render();
    clear_intents(); tap_control("Recording storage");
    assert(last_action(APP_MENU)->x == APP_OVERLAY_RECORDING_STORAGE);
    s_state.overlay = APP_OVERLAY_RECORDING_STORAGE; ++s_state.ui_revision;
    s_state.recording_storage = (app_recording_storage_view_t){0};
    screenshot("recording-storage-unknown");
    assert(has_visible_label(lv_screen_active(), "Capacity unavailable"));
    assert(has_visible_label(lv_screen_active(), "Remaining time unavailable"));
    clear_intents(); tap_control("Prepare unavailable");
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage = (app_recording_storage_view_t){
        .state = APP_RECORD_STORE_UNPREPARED, .backend = APP_RECORD_BACKEND_INTERNAL_RESERVED,
        .generation = 31, .revision = 47, .reserved_region_verified = true, .can_prepare = true
    };
    strcpy(s_state.recording_storage.reason, "The dedicated internal recording area is not prepared.");
    screenshot("recording-storage-unprepared");
    clear_intents(); tap_control("Prepare storage");
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 1);
    const app_intent_t *request = last_action(APP_RECORDING_STORAGE_PREPARE_REQUEST);
    assert(request->recording_storage_generation == 31 && request->recording_storage_revision == 47);
    assert(action_count(APP_CONFIRM) == 0 && s_state.recording_storage.state == APP_RECORD_STORE_UNPREPARED);
    clear_intents(); pointer(240, 390, true);
    ++s_state.recording_storage.revision; render(); pointer(240, 390, false);
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.backend = APP_RECORD_BACKEND_EXTERNAL_NAND;
    screenshot("recording-storage-external-preserved");
    clear_intents(); tap_control("Prepare unavailable");
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.backend = APP_RECORD_BACKEND_UNKNOWN;
    render(); clear_intents(); tap_control("Prepare unavailable");
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.backend = APP_RECORD_BACKEND_INTERNAL_RESERVED;
    s_state.recording_storage.reserved_region_verified = false;
    screenshot("recording-storage-unverified");
    clear_intents(); tap_control("Prepare unavailable");
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.reserved_region_verified = true;
    s_state.recording_storage.generation = 0;
    render(); clear_intents(); tap_control("Prepare unavailable");
    assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.generation = 31;
    s_state.overlay = APP_OVERLAY_CONFIRM;
    s_state.confirmation = APP_CONFIRM_RECORDING_STORAGE_PREPARE;
    ++s_state.ui_revision;
    screenshot("recording-storage-prepare-confirmation");
    assert(has_visible_label(lv_screen_active(), "Factory NAND storage stays untouched"));
    clear_intents(); tap_control("Cancel");
    assert(last_action(APP_CONFIRM)->x == 0);
    clear_intents(); tap_control("Prepare storage");
    const app_intent_t *confirmed = last_action(APP_CONFIRM);
    assert(confirmed->x == 1 && confirmed->recording_storage_generation == 31 && confirmed->recording_storage_revision == 48);
    clear_intents(); pointer(356, 448, true);
    ++s_state.recording_storage.generation; render(); pointer(356, 448, false);
    assert(action_count(APP_CONFIRM) == 0);
    s_state.recording_storage.backend = APP_RECORD_BACKEND_EXTERNAL_NAND;
    screenshot("recording-storage-confirmation-rejected");
    clear_intents(); tap_control("Prepare storage"); assert(action_count(APP_CONFIRM) == 0);
    s_state.recording_storage.backend = APP_RECORD_BACKEND_INTERNAL_RESERVED;
    s_state.overlay = APP_OVERLAY_RECORDING_STORAGE; ++s_state.ui_revision;
    s_state.recording_storage.state = APP_RECORD_STORE_PREPARING;
    strcpy(s_state.recording_storage.reason, "Preparing the explicitly selected reserved region.");
    screenshot("recording-storage-preparing");
    clear_intents(); tap_control("Preparing..."); assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.state = APP_RECORD_STORE_READY;
    s_state.recording_storage.can_prepare = false;
    s_state.recording_storage.capacity_known = true;
    s_state.recording_storage.free_bytes = 768 * 1024;
    s_state.recording_storage.quota_bytes = 896 * 1024;
    s_state.recording_storage.remaining_time_known = true;
    s_state.recording_storage.remaining_seconds = 7;
    strcpy(s_state.recording_storage.profile, "PCM16 mono 48 kHz");
    strcpy(s_state.recording_storage.reason, "Limited internal capacity; capture requires a separate explicit start.");
    screenshot("recording-storage-ready-limited");
    assert(has_visible_label(lv_screen_active(), "Free: 768.00 KiB"));
    assert(has_visible_label(lv_screen_active(), "Remaining: 0m 07s"));
    clear_intents(); tap_control("Storage ready"); assert(action_count(APP_RECORDING_STORAGE_PREPARE_REQUEST) == 0);
    s_state.recording_storage.state = APP_RECORD_STORE_FULL;
    s_state.recording_storage.free_bytes = 0;
    s_state.recording_storage.remaining_seconds = 0;
    strcpy(s_state.recording_storage.reason, "No space remains within the current recording quota.");
    screenshot("recording-storage-full");
    assert(has_visible_label(lv_screen_active(), "Free: 0 bytes"));
    assert(has_visible_label(lv_screen_active(), "Remaining: 0m 00s"));
    s_state.recording_storage.free_bytes = s_state.recording_storage.quota_bytes + 1;
    screenshot("recording-storage-inconsistent-capacity");
    assert(has_visible_label(lv_screen_active(), "Capacity unavailable"));
    assert(has_visible_label(lv_screen_active(), "Remaining time unavailable"));
    s_state.recording_storage.state = APP_RECORD_STORE_ERROR;
    s_state.recording_storage.capacity_known = s_state.recording_storage.remaining_time_known = false;
    strcpy(s_state.recording_storage.reason, "The reserved recording store could not be opened.");
    screenshot("recording-storage-error");
    s_state.recording_storage.state = APP_RECORD_STORE_UNCERTAIN;
    memset(s_state.recording_storage.profile, 'W', 32); s_state.recording_storage.profile[32] = '\0';
    memset(s_state.recording_storage.reason, 'W', 96); s_state.recording_storage.reason[96] = '\0';
    screenshot("recording-storage-uncertain-long-text");
    clear_intents(); tap_control("Back to Audio"); assert(last_action(APP_MENU)->x == APP_OVERLAY_AUDIO);
    s_state = original; render(); clear_intents();
    puts("PASS: actual recording capacity/time, verified internal-only preparation, separate confirmation, stale identity rejection and preserved external NAND");
}
