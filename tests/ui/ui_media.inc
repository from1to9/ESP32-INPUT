static void media_checks(void)
{
    audio_core_checks();
    audio_level_checks();
    app_view_t original = s_state;
    const app_media_request_t *request;
    s_state.mode = INPUT_AUDIO;
    s_state.overlay = APP_OVERLAY_NONE;
    s_state.locked = s_state.screen_off = s_state.remote_owned = false;
    s_state.audio_active = s_state.listening = s_state.capture_indicator_required = false;
    ui_fixture_media(&s_state);
    s_state.overlay = APP_OVERLAY_RECORDING_START; ++s_state.ui_revision;
    screenshot("recording-options");
    clear_intents(); tap_control("Profile / PCM16 mono 48 kHz");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_RECORD_SET_PROFILE);
    assert(last_action(APP_MEDIA_CONTROL)->media.value.profile_id == 19);
    clear_intents(); tap_control("+1 sec");
    assert(last_action(APP_MEDIA_CONTROL)->media.value.duration_seconds == 6);
    clear_intents(); tap_control("Review recording");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_RECORD_START_REQUEST);
    s_state.media_review = (app_media_review_t){.valid = true, .request = last_action(APP_MEDIA_CONTROL)->media,
        .options = s_state.media.recording_options};
    s_state.overlay = APP_OVERLAY_CONFIRM; s_state.confirmation = APP_CONFIRM_RECORDING_START; ++s_state.ui_revision;
    screenshot("recording-start-review");
    assert(has_visible_label(lv_screen_active(), "Limit: 5s / 480000 bytes"));
    clear_intents(); tap_control("Start recording");
    assert(last_action(APP_CONFIRM)->x == 1 && last_action(APP_CONFIRM)->media.operation == APP_MEDIA_RECORD_START_REQUEST);
    clear_intents(); pointer(356, 448, true); ++s_state.media_review.request.resource_revision; render(); pointer(356, 448, false);
    assert(action_count(APP_CONFIRM) == 0);
    s_state.media_review.valid = false; screenshot("recording-expired-review");
    clear_intents(); tap_control("Start recording"); assert(action_count(APP_CONFIRM) == 0);
    s_state.overlay = APP_OVERLAY_RECORDING_START; ++s_state.ui_revision;
    s_state.media.recording = (app_media_job_view_t){.known = true, .consumer_generation = 111,
        .state = APP_MEDIA_JOB_RUNNING, .can_stop = true, .can_cancel_keep = true, .can_cancel_discard = true,
        .elapsed_ms = 2300, .stored_bytes = 96000};
    s_state.media.recording.id.bytes[0] = 113;
    s_state.media.recording.object_id.bytes[0] = 115;
    s_state.media.recording_options.can_edit = s_state.media.recording_options.can_start = false;
    s_state.capture_indicator_required = true; s_state.capture_indicator_generation = 117; s_state.capture_state = APP_CAPTURE_ACTIVE;
    screenshot("recording-running");
    clear_intents(); tap_control("Stop and save");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_RECORD_STOP);
    assert(last_action(APP_MEDIA_CONTROL)->media.job_id.bytes[0] == 113);
    clear_intents(); tap_control("Cancel / keep");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_RECORD_CANCEL_KEEP);
    clear_intents(); tap_control("Cancel / discard");
    s_state.media_review = (app_media_review_t){.valid = true, .request = last_action(APP_MEDIA_CONTROL)->media, .job = s_state.media.recording};
    s_state.overlay = APP_OVERLAY_CONFIRM; s_state.confirmation = APP_CONFIRM_RECORDING_CANCEL_DISCARD; ++s_state.ui_revision;
    screenshot("recording-discard-review");
    clear_intents(); tap_control("Discard recording");
    assert(last_action(APP_CONFIRM)->media.job_id.bytes[0] == 113);
    s_state.overlay = APP_OVERLAY_RECORDING_START; ++s_state.ui_revision;
    s_state.media.recording.state = APP_MEDIA_JOB_FINALIZING;
    s_state.media.recording.can_stop = s_state.media.recording.can_cancel_keep = s_state.media.recording.can_cancel_discard = false;
    s_state.capture_state = APP_CAPTURE_STOPPING;
    screenshot("recording-finalizing");
    clear_intents(); tap_control("Review recording"); assert(action_count(APP_MEDIA_CONTROL) == 0);
    s_state.capture_indicator_required = false;
    s_state.overlay = APP_OVERLAY_RECORDINGS; ++s_state.ui_revision;
    screenshot("recordings-list");
    clear_intents(); tap_control("Synthetic recording 1");
    request = &last_action(APP_MEDIA_CONTROL)->media;
    assert(request->operation == APP_MEDIA_RECORD_SELECT && request->list_generation == 71 && request->object_id.bytes[0] == 91 && request->object_revision == 83);
    clear_intents(); pointer(240, 128, true); s_state.media.recordings.rows[0].id.bytes[0] = 99; render(); pointer(240, 128, false);
    assert(action_count(APP_MEDIA_CONTROL) == 0);
    clear_intents(); tap_control("Next");
    assert(last_action(APP_MEDIA_CONTROL)->media.value.page_delta == 1);
    s_state.media.recordings.pending = true; screenshot("recordings-loading");
    clear_intents(); tap_control("Synthetic recording 1"); assert(action_count(APP_MEDIA_CONTROL) == 0);
    s_state.media.recordings.pending = false; s_state.media.recordings.row_count = 0; screenshot("recordings-empty");
    s_state.overlay = APP_OVERLAY_RECORDING_DETAIL; ++s_state.ui_revision;
    screenshot("recording-details");
    clear_intents(); tap_control("Play");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_RECORD_PLAY && last_action(APP_MEDIA_CONTROL)->media.object_id.bytes[0] == 91);
    clear_intents(); tap_control("Delete");
    s_state.media_review = (app_media_review_t){.valid = true, .request = last_action(APP_MEDIA_CONTROL)->media, .recording = s_state.media.selected_recording};
    s_state.overlay = APP_OVERLAY_CONFIRM; s_state.confirmation = APP_CONFIRM_RECORDING_DELETE; ++s_state.ui_revision;
    screenshot("recording-delete-review");
    clear_intents(); tap_control("Delete recording");
    assert(last_action(APP_CONFIRM)->media.object_revision == 83);
    s_state.overlay = APP_OVERLAY_RECORDING_DETAIL; ++s_state.ui_revision;
    s_state.media.playback = (app_media_job_view_t){.known = true, .can_stop = true, .consumer_generation = 123};
    s_state.media.playback.id.bytes[0] = 125;
    screenshot("recording-playback");
    clear_intents(); tap_control("Stop playback");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_PLAYBACK_STOP && last_action(APP_MEDIA_CONTROL)->media.job_id.bytes[0] == 125);
    s_state.mode = INPUT_KEYBOARD; s_state.keyboard_submode = APP_KEYBOARD_SPOKEN; s_state.overlay = APP_OVERLAY_NONE;
    s_state.sending = false; ++s_state.ui_revision;
    screenshot("speech-ready");
    clear_intents(); tap_control("Start listening");
    assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_SPEECH_START && last_action(APP_MEDIA_CONTROL)->media.speech_generation == 101);
    s_state.media.speech.state = APP_SPEECH_LISTENING;
    s_state.media.speech.can_listen = false; s_state.media.speech.can_stop = true;
    s_state.media.speech.remaining_known = true; s_state.media.speech.remaining_seconds = 7;
    s_state.capture_indicator_required = true; s_state.capture_state = APP_CAPTURE_ACTIVE;
    screenshot("speech-listening-window");
    clear_intents(); tap_control("Stop listening"); assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_SPEECH_STOP);
    s_state.media.speech.state = APP_SPEECH_CANDIDATE;
    s_state.media.speech.candidate = 'K'; s_state.media.speech.candidate_id = 127;
    s_state.media.speech.can_confirm = s_state.media.speech.can_reject = true;
    s_state.media.speech.can_stop = false; s_state.capture_indicator_required = false;
    screenshot("speech-candidate");
    clear_intents(); tap_control("Confirm letter");
    request = &last_action(APP_MEDIA_CONTROL)->media;
    assert(request->operation == APP_MEDIA_SPEECH_CONFIRM && request->candidate_id == 127 && request->value.candidate == 'K');
    assert(action_count(APP_SEND) == 0 && action_count(APP_TEXT) == 0);
    clear_intents(); pointer(228, 340, true); ++s_state.media.speech.candidate_id; render(); pointer(228, 340, false);
    assert(action_count(APP_MEDIA_CONTROL) == 0);
    clear_intents(); tap_control("Reject"); assert(last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_SPEECH_REJECT);
    s_state.media.speech.candidate = '?'; screenshot("speech-invalid-candidate");
    assert(!find_control(lv_screen_active(), "Confirm letter"));
    s_state.overlay = APP_OVERLAY_RECORDING_DETAIL; s_state.mode = INPUT_AUDIO; ++s_state.ui_revision;
    memset(s_state.media.selected_recording.label, 'W', sizeof(s_state.media.selected_recording.label));
    memset(s_state.media.selected_recording.reason, 'W', sizeof(s_state.media.selected_recording.reason));
    screenshot("recording-long-owner-text");
    s_state.overlay = APP_OVERLAY_RECORDINGS; ++s_state.ui_revision;
    s_state.media.recordings.row_count = APP_MEDIA_ROWS + 1;
    screenshot("recordings-invalid-count");
    assert(has_visible_label(lv_screen_active(), "Recording list unavailable"));
    s_state = original; render(); clear_intents();
    puts("PASS: independent Mic/Speaker controls, immutable record and speech identities, reviews, no optimistic mutation or automatic send");
}
