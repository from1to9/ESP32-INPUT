static void bluetooth_management_checks(void)
{
    audio_pairing_checks();
    app_view_t original = s_state;
    s_state.mode = INPUT_MOUSE; s_state.locked = s_state.screen_off = false;
    s_state.overlay = APP_OVERLAY_BLUETOOTH_DEVICES; s_state.bluetooth_audio_devices = true;
    s_state.local_access = APP_LOCAL_BROWSE;
    ui_fixture_media(&s_state); ui_fixture_connections(&s_state);
    s_state.media.devices = (app_media_devices_view_t){.known = true, .count = 5, .pages = 2, .revision = 17};
    for (unsigned i = 0; i < 4; ++i) {
        s_state.media.devices.rows[i].id.bytes[15] = (uint8_t)(i + 1);
        snprintf(s_state.media.devices.rows[i].identity, 24, "01:00:00:00:00:%02X", i + 1);
    }
    ++s_state.ui_revision; screenshot("bluetooth-audio-browse");
    clear_intents(); tap_control("Next");
    assert(action_count(APP_MEDIA_CONTROL) == 1 && last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_DEVICE_PAGE);
    clear_intents(); tap_control("01:00:00:00:00:01   Saved");
    assert(action_count(APP_MEDIA_CONTROL) == 1 && last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_DEVICE_DETAILS);
    s_state.media.devices.known = false; s_state.media.devices.refreshing = false; s_state.media.devices.can_refresh = true;
    s_state.media.pairing.state = APP_MEDIA_PAIR_CLOSED;
    ++s_state.ui_revision; screenshot("bluetooth-audio-unavailable-list");
    assert(has_visible_label(lv_screen_active(), "01:00:00:00:00:01   Saved state unknown"));
    clear_intents(); tap_control("Refresh");
    assert(action_count(APP_MEDIA_CONTROL) == 1 && last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_DEVICE_REFRESH);
    s_state.media.devices.known = true; s_state.media.devices.pending = true; s_state.media.devices.can_refresh = false;
    ++s_state.ui_revision; screenshot("bluetooth-audio-link-wait");
    assert(has_visible_label(lv_screen_active(), "Pairing closed\nWaiting for the link request"));
    clear_intents(); tap_control("Refresh"); assert(!action_count(APP_MEDIA_CONTROL));
    s_state.media.devices.pending = false;
    s_state.media.devices.request_failed = true;
    ++s_state.ui_revision; screenshot("bluetooth-audio-link-failed");
    assert(has_visible_label(lv_screen_active(), "Pairing closed\nLink request failed or uncertain"));
    s_state.media.pairing.state = APP_MEDIA_PAIR_DISCOVERABLE;
    s_state.media.pairing.remaining_seconds = 97;
    s_state.media.pairing.name_known = true;
    strcpy(s_state.media.pairing.device_name, "Mosaico-AUD");
    ++s_state.ui_revision; screenshot("bluetooth-audio-pair-from-host");
    audio_assert_text_fits("Discoverable / 97s\nPair from your host using the search name");
    s_state.media.devices.request_failed = false;
    clear_intents(); tap_control("Add device"); tap_control("Stop pairing"); assert(!action_count(APP_MEDIA_CONTROL));
    s_state.media.devices.known = false; s_state.media.devices.refreshing = true;
    s_state.media.pairing.state = APP_MEDIA_PAIR_CLOSED;
    ++s_state.ui_revision; screenshot("bluetooth-audio-refresh-list");
    assert(has_visible_label(lv_screen_active(), "01:00:00:00:00:01   Checking saved state"));
    clear_intents(); tap_control("01:00:00:00:00:01   Checking saved state");
    assert(action_count(APP_MEDIA_CONTROL) == 1 && last_action(APP_MEDIA_CONTROL)->media.operation == APP_MEDIA_DEVICE_DETAILS);
    s_state.overlay = APP_OVERLAY_AUDIO_DEVICE;
    strcpy(s_state.media.devices.identity, "01:00:00:00:00:01");
    s_state.media.devices.can_connect[0] = s_state.media.devices.can_connect[1] = true;
    s_state.media.devices.connection_known[0] = s_state.media.devices.connection_known[1] = true;
    s_state.media.devices.connected[1] = true; s_state.media.devices.refreshing = true;
    strcpy(s_state.media.devices.reason, "Refreshing saved audio devices.");
    ++s_state.ui_revision; screenshot("bluetooth-audio-refresh-detail");
    assert(has_visible_label(lv_screen_active(), "01:00:00:00:00:01"));
    assert(has_visible_label(lv_screen_active(), "Mic: Disconnected / Speaker: Connected"));
    assert(!has_visible_label(lv_screen_active(), "Device no longer saved"));
    clear_intents(); tap_control("Connect mic"); tap_control("Connect speaker"); assert(!action_count(APP_MEDIA_CONTROL));
    clear_intents(); tap_control("Back to devices"); assert(action_count(APP_BLUETOOTH_DEVICES) == 1);
    s_state.bluetooth_hosts_available = false;
    strcpy(s_state.media.devices.reason, "Connect failed. Host asks to pair? Go back and use Add device.");
    ++s_state.ui_revision; screenshot("bluetooth-audio-connect-help");
    audio_assert_text_fits("Connect failed. Host asks to pair? Go back and use Add device.\nInput pairing state unknown. Audio Forget unavailable; Disconnect keeps pairing.");
    s_state.media.devices.connected[0] = true;
    ++s_state.ui_revision; screenshot("bluetooth-audio-slctovoice");
    assert(has_visible_label(lv_screen_active(), "Mic: Service connected / Speaker: Connected"));
    s_state.media.devices.connection_known[1] = false;
    ++s_state.ui_revision; screenshot("bluetooth-audio-unknown-detail");
    assert(has_visible_label(lv_screen_active(), "Mic: Service connected / Speaker: Unknown"));
    s_state.local_access = APP_LOCAL_PAUSED; ++s_state.ui_revision; render();
    clear_intents(); tap_control("Back to devices"); assert(!action_count(APP_BLUETOOTH_DEVICES));
    s_state.overlay = APP_OVERLAY_BLUETOOTH_DEVICES; s_state.bluetooth_audio_devices = false;
    s_state.local_access = APP_LOCAL_BROWSE; ++s_state.ui_revision; render();
    clear_intents(); tap_control("More"); assert(last_action(APP_MENU)->x == APP_OVERLAY_BLUETOOTH_INPUT_OPTIONS);
    s_state.bluetooth_hosts_available = true; s_state.bluetooth_host_count = 9; s_state.bluetooth_page = 1;
    s_state.bluetooth_hosts[4].target_known = true;
    strcpy(s_state.bluetooth_hosts[4].name, "Browse input");
    ++s_state.ui_revision; screenshot("bluetooth-input-browse");
    clear_intents(); tap_control("Next"); assert(last_action(APP_BLUETOOTH_PAGE)->x == 2);
    clear_intents(); tap_control("Previous"); assert(last_action(APP_BLUETOOTH_PAGE)->x == 0);
    clear_intents(); tap_control("Browse input   Saved");
    assert(last_action(APP_BLUETOOTH_TARGET_CONTROL)->bluetooth_target.operation == APP_BLUETOOTH_TARGET_DETAILS);
    s_state.overlay = APP_OVERLAY_BLUETOOTH_INPUT_OPTIONS; s_state.bluetooth_reconnect_paused = true;
    s_state.bluetooth_host_count = 2; s_state.bluetooth_hosts_available = true;
    s_state.bluetooth_name.available = true; ++s_state.ui_revision; screenshot("bluetooth-input-options-browse");
    clear_intents(); tap_control("Resume"); tap_control("Forget all"); tap_control("Device name");
    assert(!action_count(APP_PAIRING_REQUEST) && !action_count(APP_BLUETOOTH_NAME_EDIT));
    s_state.local_access = APP_LOCAL_NORMAL; ++s_state.ui_revision; screenshot("bluetooth-input-options");
    clear_intents(); tap_control("Resume"); assert(last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_RESUME);
    clear_intents(); tap_control("Forget all"); assert(last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_FORGET_ALL);
    clear_intents(); tap_control("Device name"); assert(last_action(APP_SETTINGS_PAGE)->x == APP_SETTINGS_DEVICE_NAME);
    clear_intents(); tap_control("Back to devices"); assert(last_action(APP_BLUETOOTH_DEVICES)->x == 0);
    s_state = original; render();
    s_state.mode = INPUT_MOUSE; s_state.locked = s_state.screen_off = false;
    s_state.overlay = APP_OVERLAY_BLUETOOTH_PAIRING;
    s_state.bluetooth_name.effective_valid = true;
    strcpy(s_state.bluetooth_name.effective, "Mosaico");
    s_state.bluetooth_management = (app_bluetooth_management_view_t){.known = true, .pending = true, .can_stop = true};
    strcpy(s_state.bluetooth_management.status, "Preparing pairing");
    strcpy(s_state.bluetooth_management.reason, "Waiting for the current Bluetooth host to disconnect.");
    ++s_state.ui_revision; screenshot("bluetooth-add-preparing");
    assert(has_visible_label(lv_screen_active(), "Mosaico"));
    assert(has_visible_label(lv_screen_active(), "Preparing pairing"));
    clear_intents(); tap_control("Stop pairing");
    assert(action_count(APP_PAIRING_REQUEST) == 1 && last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_CLOSE);
    assert(s_state.overlay == APP_OVERLAY_BLUETOOTH_PAIRING); /* Callback only queues intent. */
    clear_intents(); tap_control("Try again"); assert(!action_count(APP_PAIRING_REQUEST));
    s_state.bluetooth_management.pending = false;
    s_state.bluetooth_management.window_open = s_state.bluetooth_management.advertising = true;
    s_state.bluetooth_management.remaining_known = true; s_state.bluetooth_management.remaining_seconds = 119;
    strcpy(s_state.bluetooth_management.status, "Pairing open");
    strcpy(s_state.bluetooth_management.reason, "Choose this device in your host's Bluetooth settings.");
    ++s_state.ui_revision; screenshot("bluetooth-add-open");
    assert(has_visible_label(lv_screen_active(), "Pairing open\n119s remaining"));
    clear_intents(); tap_control("Try again"); assert(!action_count(APP_PAIRING_REQUEST));
    s_state.bluetooth_management.connected = true;
    s_state.bluetooth_management.can_stop = false;
    strcpy(s_state.bluetooth_management.status, "Connected");
    strcpy(s_state.bluetooth_management.reason, "Bluetooth input is ready. Manage saved hosts to change or disconnect.");
    ++s_state.ui_revision; screenshot("bluetooth-add-connected");
    assert(has_visible_label(lv_screen_active(), "Connected"));
    assert(!has_visible_label(lv_screen_active(), "Pairing open\n119s remaining"));
    assert(!has_visible_label(lv_screen_active(), "Choose this device in your host's Bluetooth settings."));
    clear_intents(); tap_control("Stop pairing"); assert(!action_count(APP_PAIRING_REQUEST));
    s_state.bluetooth_management.connected = false;
    s_state.bluetooth_management.window_open = s_state.bluetooth_management.advertising = false;
    s_state.bluetooth_management.remaining_known = false;
    s_state.bluetooth_management.can_add = true; s_state.bluetooth_management.can_stop = false;
    strcpy(s_state.bluetooth_management.status, "Pairing closed");
    strcpy(s_state.bluetooth_management.reason, "Target policy was not verified. Pairing remains closed.");
    ++s_state.ui_revision; screenshot("bluetooth-add-failed");
    assert(has_visible_label(lv_screen_active(), "Pairing closed"));
    clear_intents(); tap_control("Try again");
    assert(action_count(APP_PAIRING_REQUEST) == 1 && last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_OPEN);
    clear_intents(); tap_control("Back to devices");
    assert(action_count(APP_BLUETOOTH_DEVICES) == 1 && last_action(APP_BLUETOOTH_DEVICES)->x == 0);
    s_state.overlay = APP_OVERLAY_BLUETOOTH_TARGET;
    s_state.bluetooth_target = (app_bluetooth_target_view_t){.known = true, .can_forget = true, .bond_revision = 17, .preferences_revision = 23,
        .target = {.address = {0xc3}, .address_type = 1, .bond_id_known = true}};
    memset(s_state.bluetooth_target.target.bond_id, 0x5a, 32);
    strcpy(s_state.bluetooth_target.name, "Saved input host"); strcpy(s_state.bluetooth_target.identity, "C3:00:00:00:00:00 (type 1)");
    s_state.bluetooth_target.connected = true;
    ++s_state.ui_revision; screenshot("bluetooth-current-device-detail");
    clear_intents(); tap_control("Disconnect");
    const app_intent_t *disconnect = last_action(APP_BLUETOOTH_TARGET_CONTROL);
    assert(disconnect && disconnect->bluetooth_target.operation == APP_BLUETOOTH_TARGET_DISCONNECT_REQUEST &&
        disconnect->bluetooth_target.bond_revision == 17 && disconnect->bluetooth_target.preferences_revision == 23 &&
        !memcmp(disconnect->bluetooth_target.target.bond_id, s_state.bluetooth_target.target.bond_id, 32));
    clear_intents(); pointer(356, 392, true);
    s_state.bluetooth_target.connected = false; s_state.bluetooth_target.can_prefer = true;
    render(); pointer(356, 392, false);
    assert(!action_count(APP_BLUETOOTH_TARGET_CONTROL)); /* Disconnect cannot become a priority change. */
    ++s_state.ui_revision; screenshot("bluetooth-single-forget");
    clear_intents(); tap_control("Forget this device");
    const app_intent_t *forget = last_action(APP_BLUETOOTH_TARGET_CONTROL);
    assert(forget && forget->bluetooth_target.operation == APP_BLUETOOTH_TARGET_FORGET_REQUEST &&
        forget->bluetooth_target.bond_revision == 17 && forget->bluetooth_target.preferences_revision == 23 &&
        !memcmp(forget->bluetooth_target.target.bond_id, s_state.bluetooth_target.target.bond_id, 32));
    s_state.overlay = APP_OVERLAY_CONFIRM; s_state.confirmation = APP_CONFIRM_BLUETOOTH_FORGET_ONE;
    strcpy(s_state.bluetooth_management.forget_identity, "C3:00:00:00:00:00 (type 1)");
    ++s_state.ui_revision; screenshot("bluetooth-single-forget-confirm");
    assert(has_visible_label(lv_screen_active(), "Forget this saved device?"));
    clear_intents(); tap_control("Forget this device");
    assert(action_count(APP_CONFIRM) == 1 && last_action(APP_CONFIRM)->x == 1);
    s_state.confirmation = APP_CONFIRM_DISCONNECT;
    ++s_state.ui_revision; screenshot("bluetooth-disconnect-confirm");
    assert(has_visible_label(lv_screen_active(), "Disconnect Bluetooth host?"));
    clear_intents(); tap_control("Disconnect");
    assert(action_count(APP_CONFIRM) == 1 && last_action(APP_CONFIRM)->x == 1);
    s_state.confirmation = APP_CONFIRM_PAIR_OPEN;
    ++s_state.ui_revision; screenshot("bluetooth-add-connected-confirm");
    assert(has_visible_label(lv_screen_active(), "Disconnect and add host?"));
    clear_intents(); tap_control("Disconnect and add");
    assert(action_count(APP_CONFIRM) == 1 && last_action(APP_CONFIRM)->x == 1);
    ui_fixture_connections(&s_state);
    s_state.overlay = APP_OVERLAY_BLUETOOTH_TARGET; s_state.bluetooth_target.selection_supported = false;
    s_state.bluetooth_target.can_forget = true;
    strcpy(s_state.bluetooth_target.reason, "Allow reconnect for 30s; exact selection is unavailable. Input waits for verified identity.");
    ++s_state.ui_revision; screenshot("bluetooth-private-reconnect");
    clear_intents(); tap_control("Allow reconnect");
    assert(action_count(APP_BLUETOOTH_TARGET_CONTROL) == 1 &&
        last_action(APP_BLUETOOTH_TARGET_CONTROL)->bluetooth_target.operation == APP_BLUETOOTH_TARGET_SELECT);
    s_state.overlay = APP_OVERLAY_SETTINGS; s_state.settings_page = APP_SETTINGS_BLUETOOTH;
    s_state.bluetooth_connected = false; s_state.bluetooth_reconnect_paused = true;
    ++s_state.ui_revision; screenshot("bluetooth-disconnected-resume");
    assert(!has_visible_label(lv_screen_active(), "Connected"));
    clear_intents(); tap_control("Resume");
    assert(action_count(APP_PAIRING_REQUEST) == 1 && last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_RESUME);
    lv_area_t resume; lv_obj_get_coords(control("Resume"), &resume);
    clear_intents(); pointer((resume.x1 + resume.x2) / 2, (resume.y1 + resume.y2) / 2, true);
    for (unsigned i = 0; i < 50; ++i) {
        /* Owner projections keep provisional retries out of host authority.
         * Advertising/countdown observations cannot revoke this held action. */
        s_state.bluetooth_management.advertising = (i & 1) != 0;
        s_state.bluetooth_management.remaining_seconds = 119 - i;
        render();
    }
    pointer((resume.x1 + resume.x2) / 2, (resume.y1 + resume.y2) / 2, false);
    assert(action_count(APP_PAIRING_REQUEST) == 1 && last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_RESUME);
    clear_intents(); pointer((resume.x1 + resume.x2) / 2, (resume.y1 + resume.y2) / 2, true);
    s_state.bluetooth_connected = true; render();
    pointer((resume.x1 + resume.x2) / 2, (resume.y1 + resume.y2) / 2, false);
    assert(action_count(APP_PAIRING_REQUEST) == 0); /* A press cannot flip Resume into Disconnect. */
    ++s_state.ui_revision; screenshot("bluetooth-other-peer-connected-paused");
    clear_intents(); tap_control("Disconnect");
    assert(action_count(APP_PAIRING_REQUEST) == 1 && last_action(APP_PAIRING_REQUEST)->x == APP_PAIR_DISCONNECT);
    s_state = original; render(); clear_intents();
    puts("PASS: native Bluetooth preparation/open/failure, exact Forget identity and explicit connected Add pointer paths");
}
