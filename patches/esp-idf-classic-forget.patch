 static tBTM_SEC_DEV_REC *btm_find_oldest_dev_ex (tBTM_SEC_DEV_REC *exclude_rec);
+
+#if CONFIG_APP_CLASSIC_SCAN_COORDINATION
+/* Pinned S31 archive. A zero capacity means the controller has no key
+ * store. Any other configuration needs its own deletion transaction. */
+extern uintptr_t odm_lk_store_capacity(void);
+
+esp_err_t bt_classic_forget_runtime(const uint8_t peer[6], const bt_classic_bond_id_t *expected, bool clear)
+{
+    if (odm_lk_store_capacity()) return ESP_ERR_NOT_SUPPORTED;
+    BD_ADDR address;
+    memcpy(address, peer, sizeof(address));
+    if (BTM_IsAclConnectionUp(address, BT_TRANSPORT_BR_EDR) ||
+        l2cu_find_lcb_by_bd_addr(address, BT_TRANSPORT_BR_EDR)) return ESP_ERR_INVALID_STATE;
+
+    /* Exact BR/EDR address. The general lookup also accepts LE aliases. */
+    tSecDevContext context = {.type = SEC_DEV_BDA, .context.p_bd_addr = address};
+    list_node_t *node = btm_cb.p_sec_dev_rec_list ?
+        list_foreach(btm_cb.p_sec_dev_rec_list, btm_find_sec_dev_in_list, &context) : NULL;
+    tBTM_SEC_DEV_REC *record = node ? list_node(node) : NULL;
+    if (!record || !(record->sec_flags & BTM_SEC_LINK_KEY_KNOWN)) return ESP_ERR_INVALID_VERSION;
+    if (record->hci_handle != BTM_SEC_INVALID_HANDLE || (record->sm4 & BTM_SM4_CONN_PEND) ||
+        record->sec_state != BTM_SEC_STATE_IDLE ||
+        (btm_cb.pairing_state != BTM_PAIR_STATE_IDLE && !memcmp(btm_cb.pairing_bda, address, sizeof(address)))) {
+        return ESP_ERR_INVALID_STATE;
+    }
+#if SMP_INCLUDED == TRUE
+    if (record == btm_cb.p_collided_dev_rec) return ESP_ERR_INVALID_STATE;
+#endif
+    bt_classic_bond_id_t identity;
+    if (!bt_classic_bond_id(record->link_key, &identity) || memcmp(&identity, expected, sizeof(identity))) {
+        return ESP_ERR_INVALID_VERSION;
+    }
+    if (clear) {
+        memset(record->link_key, 0, sizeof(record->link_key));
+        record->link_key_type = 0;
+        record->sec_flags &= ~(BTM_SEC_AUTHORIZED | BTM_SEC_AUTHENTICATED | BTM_SEC_ENCRYPTED |
+                               BTM_SEC_LINK_KEY_KNOWN | BTM_SEC_LINK_KEY_AUTHED | BTM_SEC_16_DIGIT_PIN_AUTHED);
+        /* Keep the record's LE link, keys, shared metadata and bond type.
+         * There is no unpair callback or GATT cancellation on this path. */
+        if (!(record->device_type & BT_DEVICE_TYPE_BLE) &&
+            record->ble_hci_handle == BTM_SEC_INVALID_HANDLE && !(record->sec_flags & BTM_SEC_LE_MASK)) {
+            list_remove(btm_cb.p_sec_dev_rec_list, record);
+        }
+    }
+    return ESP_OK;
+}
+#endif

