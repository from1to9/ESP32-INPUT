 *******************************************************************************/
+#if CONFIG_APP_CLASSIC_SCAN_COORDINATION
+bool bt_classic_bond_id(const uint8_t key[16], bt_classic_bond_id_t *out)
+{
+    size_t length = 0;
+    return psa_hash_compute(PSA_ALG_SHA_256, key, sizeof(LINK_KEY), out->bytes, sizeof(out->bytes), &length) ==
+        PSA_SUCCESS && length == sizeof(out->bytes);
+}
+
+static bool classic_identity_locked(const char *address, LINK_KEY key, bt_classic_bond_id_t *id)
+{
+    size_t length = sizeof(LINK_KEY);
+    return btc_config_get_bin(address, BTC_STORAGE_LINK_KEY_STR, key, &length) &&
+        length == sizeof(LINK_KEY) && bt_classic_bond_id(key, id);
+}
+
+static void classic_address_string(const uint8_t peer[6], bdstr_t address)
+{
+    bt_bdaddr_t selected;
+    memcpy(selected.address, peer, sizeof(selected.address));
+    bdaddr_to_string(&selected, address, sizeof(bdstr_t));
+}
+
+esp_err_t bt_classic_forget_review(const uint8_t peer[6], bt_classic_bond_id_t *out)
+{
+    if (psa_crypto_init() != PSA_SUCCESS) return ESP_FAIL;
+    bdstr_t address;
+    LINK_KEY key = {0};
+    classic_address_string(peer, address);
+    btc_config_lock();
+    esp_err_t result = bt_classic_forget_config_check();
+    if (result == ESP_OK && !classic_identity_locked(address, key, out)) result = ESP_ERR_NOT_FOUND;
+    btc_config_unlock();
+    mbedtls_platform_zeroize(key, sizeof(key));
+    return result;
+}
+
+esp_err_t bt_classic_forget_storage(const uint8_t peer[6], const bt_classic_bond_id_t *expected)
+{
+    bdstr_t address;
+    bt_classic_bond_id_t identity;
+    LINK_KEY key = {0};
+    int type, pin;
+    uint8_t sc;
+    size_t sc_length = sizeof(sc);
+    classic_address_string(peer, address);
+
+    btc_config_lock();
+    esp_err_t result = bt_classic_forget_config_check();
+    if (result != ESP_OK) goto done;
+    result = ESP_ERR_INVALID_VERSION;
+    if (classic_identity_locked(address, key, &identity) &&
+               !memcmp(&identity, expected, sizeof(identity)) &&
+               btc_config_get_int(address, BTC_STORAGE_LINK_KEY_TYPE_STR, &type) &&
+               btc_config_get_int(address, BTC_STORAGE_PIN_LENGTH_STR, &pin) &&
+               btc_config_get_bin(address, BTC_STORAGE_SC_SUPPORT, &sc, &sc_length) &&
+               sc_length == sizeof(sc)) {
+        bool removed = btc_config_remove(address, BTC_STORAGE_LINK_KEY_STR);
+        removed &= btc_config_remove(address, BTC_STORAGE_LINK_KEY_TYPE_STR);
+        removed &= btc_config_remove(address, BTC_STORAGE_PIN_LENGTH_STR);
+        removed &= btc_config_remove(address, BTC_STORAGE_SC_SUPPORT);
+        if (removed && bt_classic_forget_config_save()) {
+            result = ESP_OK;
+        } else {
+            /* A failed write does not prove which image is durable. Retain
+             * the old cache; the owner reports an unconfirmed result. */
+            btc_config_set_bin(address, BTC_STORAGE_LINK_KEY_STR, key, sizeof(key));
+            btc_config_set_int(address, BTC_STORAGE_LINK_KEY_TYPE_STR, type);
+            btc_config_set_int(address, BTC_STORAGE_PIN_LENGTH_STR, pin);
+            btc_config_set_bin(address, BTC_STORAGE_SC_SUPPORT, &sc, sizeof(sc));
+            result = ESP_ERR_NOT_FINISHED;
+        }
+    }
+done:
+    btc_config_unlock();
+    mbedtls_platform_zeroize(key, sizeof(key));
+    return result;
+}
+#endif
