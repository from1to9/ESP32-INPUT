+#if CONFIG_APP_CLASSIC_SCAN_COORDINATION
+bool bt_classic_forget_fits_single_blob(const config_t *current)
+{
+    size_t size;
+    /* The size includes the terminating NUL, which is not written. A blob
+     * exactly CONFIG_FILE_MAX_SIZE bytes is a continuation on readback. */
+    return get_config_size(current, &size) && size <= CONFIG_FILE_MAX_SIZE;
+}
+
+esp_err_t bt_classic_forget_check_single_blob(const char *filename)
+{
+    nvs_handle_t handle;
+    esp_err_t error = nvs_open(filename, NVS_READONLY, &handle);
+    if (error != ESP_OK) return error;
+    size_t length = 0;
+    error = nvs_get_blob(handle, CONFIG_KEY "0", NULL, &length);
+    nvs_close(handle);
+    /* The existing reader ignores every continuation if chunk zero is
+     * shorter than the continuation size. No separate index is written. */
+    if (error != ESP_OK) return error;
+    if (!length) return ESP_ERR_INVALID_STATE;
+    return length < CONFIG_FILE_MAX_SIZE ? ESP_OK : ESP_ERR_INVALID_SIZE;
+}
+#endif

