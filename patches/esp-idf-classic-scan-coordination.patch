     uint8_t *stream = hack->response->data + hack->response->offset + 3; // 2 to skip the event headers, 1 to skip the command credits
     STREAM_TO_UINT16(opcode, stream);

+    if (opcode == HCI_WRITE_SCAN_ENABLE) {
+        bool accepted = hack->response->len == 6 && *stream == HCI_SUCCESS;
+        const char *lane = hack->context ? "prepare" : "policy";
